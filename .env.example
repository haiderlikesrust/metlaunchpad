# Server-only values. Never prefix credentials with NEXT_PUBLIC_ or VITE_.
QUICKNODE_RPC_URL=
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=
AGENT_CRON_TOKEN=

# Unconfigured/unavailable models cannot execute; no silent fallback.

# Platform funding settings, never creator-controlled.
SOLCARD_DEPOSIT_ADDRESS=
AGENT_DAILY_FUNDING_CAP_USD=unlimited

# Base64-encoded 32-byte encryption key for dedicated agent wallets.
AGENT_WALLET_ENCRYPTION_KEY=


# Main THICC mint for the fixed 10% fee buyback and burn. Add after token creation.
THICC_TOKEN_MINT=

# Jupiter v2 swaps and v3 quote prices (required for custom quotes and buybacks).
JUPITER_API_KEY=
# Pause new agent transfers while still reconciling submitted signatures.
EXECUTION_PAUSED=false
