# Paste in Dokploy's Environment editor. Never commit filled-in secrets.
APP_ORIGIN=https://thicc.money
# Generate separately: openssl rand -hex 32
SESSION_SECRET=
AGENT_CRON_TOKEN=
QUICKNODE_RPC_URL=
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=
# Generate once: openssl rand -base64 32. Back up separately; do not rotate after launch.
AGENT_WALLET_ENCRYPTION_KEY=
SOLCARD_DEPOSIT_ADDRESS=
# Add after the main THICC token is created. Empty keeps buybacks pending.
THICC_TOKEN_MINT=

# Jupiter v2 swaps and v3 quote prices (required for custom quotes and buybacks).
JUPITER_API_KEY=
# Pause new agent transfers while still reconciling submitted signatures.
EXECUTION_PAUSED=false
